# Django
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (local ou distante via .env)
DB_NAME=electroMedos
DB_USER=postgres
